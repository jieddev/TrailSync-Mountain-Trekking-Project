DATABASE_URL="postgresql://trailsync_app:replace-with-your-local-password@127.0.0.1:5432/trailsync_dev?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Use a Firebase service account for local development. Keep the private key on
# one line and represent line breaks as \n. Alternatively, use Application
# Default Credentials with GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

LOG_LEVEL=debug
LOG_PRETTY=true

# Sign-up codes and certificate emails. In production (Render's free tier
# blocks SMTP) set BREVO_API_KEY; MAIL_FROM must then be a sender verified in
# Brevo. Locally you can use Gmail SMTP instead: turn on 2-Step Verification
# and create an app password (Google Account > Security > App passwords).
# With neither BREVO_API_KEY nor SMTP_USER, emails are only logged.
BREVO_API_KEY=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TrailSync <your-address@gmail.com>"

# Advisory weather from OpenWeather (free plan: current weather and the 5-day
# forecast). Without a key, GET /api/v1/weather answers 503 WEATHER_UNAVAILABLE.
# The point defaults to the Cabintan jump-off from the provisional trail KML.
OPENWEATHER_API_KEY=""
# WEATHER_LAT=11.080324
# WEATHER_LNG=124.722855
# WEATHER_LOCATION_NAME="Cabintan jump-off"

# GCash payment details shown to hikers (test mode: no money moves through
# TrailSync; coordinators check the uploaded screenshot). Defaults are
# placeholders. Receipt screenshots are stored in the database
# (payment_receipt_files). UPLOAD_DIR only matters for screenshots saved on
# disk before that (default: backend/uploads, which is git-ignored).
# GCASH_ACCOUNT_NAME="TrailSync Tourism Office (TEST)"
# GCASH_ACCOUNT_NUMBER="0917 000 0000"
# UPLOAD_DIR="uploads"
