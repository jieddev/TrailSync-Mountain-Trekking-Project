DATABASE_URL="postgresql://trailsync_app:replace-with-your-local-password@127.0.0.1:5432/trailsync_dev?schema=public"
PORT=3000
CORS_ORIGIN="http://localhost:5173"
# Use a Firebase service account for local development. Keep the private key on
# one line and represent line breaks as \n. Alternatively, use Application
# Default Credentials with GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

LOG_LEVEL=debug
LOG_PRETTY=true

# Certificate emails sent when a trek is completed. For Gmail, turn on 2-Step
# Verification and create an app password (Google Account > Security > App
# passwords). Leave SMTP_USER empty to only log the emails instead of sending.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="TrailSync <your-address@gmail.com>"
