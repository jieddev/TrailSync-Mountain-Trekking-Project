generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HIKER
  GUIDE
  COORDINATOR
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  GUIDE_ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum DownpaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
}

enum BookingParticipantType {
  BOOKING_OWNER
  ADDITIONAL_PARTICIPANT
  WALK_IN
}

enum ParticipantAttendance {
  PRESENT
  ABSENT
}

enum GuideDutyStatus {
  OFF_DUTY
  AVAILABLE
  ASSIGNED
}

enum GuideApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id                        String             @id @default(cuid())
  firebaseUid               String             @unique
  fullName                  String
  email                     String             @unique
  role                      UserRole           @default(HIKER)
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  bookings                  Booking[]
  guide                     Guide?
  reviewedGuideApplications GuideApplication[] @relation("GuideApplicationReviewer")

  @@map("users")
}

// A trek guide's request for an account. The GUIDE user is created only when a
// coordinator approves it, so applicants have no TrailSync profile until then.
model GuideApplication {
  id            String                 @id @default(cuid())
  firebaseUid   String                 @unique
  fullName      String
  email         String
  status        GuideApplicationStatus @default(PENDING)
  declineReason String?
  reviewedById  String?
  reviewedBy    User?                  @relation("GuideApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
  @@map("guide_applications")
}

// Dispatch state for a GUIDE user. AVAILABLE guides form the FIFO queue ordered
// by availableSince; only dispatch sets ASSIGNED (see src/lib/guide-queue.ts).
model Guide {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dutyStatus     GuideDutyStatus @default(OFF_DUTY)
  availableSince DateTime?
  bookings       Booking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([dutyStatus, availableSince])
  @@map("guides")
}

model Trail {
  id           String    @id @default(cuid())
  slug         String    @unique
  name         String
  description  String?
  packagePrice Int
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bookings     Booking[]

  @@map("trails")
}

model Booking {
  id                String               @id @default(cuid())
  ownerId           String
  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  trailId           String
  trail             Trail                @relation(fields: [trailId], references: [id], onDelete: Restrict)
  scheduledDate     String
  scheduledTime     String
  packagePrice      Int
  downpaymentAmount Int
  status            BookingStatus        @default(PENDING_CONFIRMATION)
  downpaymentStatus DownpaymentStatus    @default(PENDING_VERIFICATION)
  guideId           String?
  guide             Guide?               @relation(fields: [guideId], references: [id], onDelete: Restrict)
  checkedInAt       DateTime?
  guideAssignedAt   DateTime?
  trekStartedAt     DateTime?
  completedAt       DateTime?
  participants      BookingParticipant[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([ownerId, createdAt])
  @@index([trailId, scheduledDate])
  @@index([status, checkedInAt])
  @@index([guideId])
  @@map("bookings")
}

model BookingParticipant {
  id         String                 @id @default(cuid())
  bookingId  String
  booking    Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind       BookingParticipantType
  name       String
  age        Int
  address    String
  attendance ParticipantAttendance?

  @@index([bookingId])
  @@map("booking_participants")
}
