generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HIKER
  GUIDE
  COORDINATOR
}

enum BookingStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  GUIDE_ASSIGNED
  IN_PROGRESS
  COMPLETED
}

enum DownpaymentStatus {
  PENDING_VERIFICATION
  VERIFIED
  // The coordinator rejected the latest receipt; the hiker can upload a new one.
  REJECTED
}

// How much the hiker pays by GCash when booking. With DOWNPAYMENT the rest is
// paid in cash at check-in.
enum PaymentOption {
  DOWNPAYMENT
  FULL
}

enum ReceiptStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum BookingParticipantType {
  BOOKING_OWNER
  ADDITIONAL_PARTICIPANT
  WALK_IN
}

enum ParticipantAttendance {
  PRESENT
  ABSENT
}

enum GuideDutyStatus {
  OFF_DUTY
  AVAILABLE
  ASSIGNED
}

enum GuideApplicationStatus {
  PENDING
  APPROVED
  DECLINED
}

model User {
  id                        String             @id @default(cuid())
  firebaseUid               String             @unique
  fullName                  String
  email                     String             @unique
  // Entered at registration; null for accounts made before it was asked (they give it when booking).
  age                       Int?
  role                      UserRole           @default(HIKER)
  // Terms of Use and Privacy Policy accepted at registration; null for accounts made before agreements existed.
  termsAcceptedAt           DateTime?
  termsVersion              String?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  bookings                  Booking[]
  guide                     Guide?
  reviewedGuideApplications GuideApplication[] @relation("GuideApplicationReviewer")
  createdTrailRestrictions  TrailRestriction[] @relation("TrailRestrictionCreator")
  liftedTrailRestrictions   TrailRestriction[] @relation("TrailRestrictionLifter")
  acknowledgedIncidents     Incident[]         @relation("IncidentAcknowledger")
  resolvedIncidents         Incident[]         @relation("IncidentResolver")
  reviewedPaymentReceipts   PaymentReceipt[]   @relation("PaymentReceiptReviewer")
  collectedBalances         Booking[]          @relation("BookingBalanceCollector")

  @@map("users")
}

// A trek guide's request for an account. The GUIDE user is created only when a
// coordinator approves it, so applicants have no TrailSync profile until then.
model GuideApplication {
  id            String                 @id @default(cuid())
  firebaseUid   String                 @unique
  fullName      String
  email         String
  status        GuideApplicationStatus @default(PENDING)
  declineReason String?
  reviewedById  String?
  reviewedBy    User?                  @relation("GuideApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, createdAt])
  @@map("guide_applications")
}

// Dispatch state for a GUIDE user. AVAILABLE guides form the FIFO queue ordered
// by availableSince; only dispatch sets ASSIGNED (see src/lib/guide-queue.ts).
model Guide {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  dutyStatus     GuideDutyStatus @default(OFF_DUTY)
  availableSince DateTime?
  bookings       Booking[]
  incidents      Incident[]
  locations      GuideLocation[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([dutyStatus, availableSince])
  @@map("guides")
}

model Trail {
  id           String             @id @default(cuid())
  slug         String             @unique
  name         String
  description  String?
  packagePrice Int
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  bookings     Booking[]
  restrictions TrailRestriction[]

  @@map("trails")
}

// A coordinator's closure of one trail for an inclusive range of Asia/Manila
// dates (for example, bad weather). While it applies, the server refuses new
// bookings, reschedules, check-in, guide assignment and trek starts on that
// trail. Lifting keeps the row as a record instead of deleting it.
model TrailRestriction {
  id          String    @id @default(cuid())
  trailId     String
  trail       Trail     @relation(fields: [trailId], references: [id], onDelete: Restrict)
  startDate   String
  endDate     String
  reason      String
  createdById String
  createdBy   User      @relation("TrailRestrictionCreator", fields: [createdById], references: [id], onDelete: Restrict)
  liftedAt    DateTime?
  liftedById  String?
  liftedBy    User?     @relation("TrailRestrictionLifter", fields: [liftedById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([trailId, startDate, endDate])
  @@map("trail_restrictions")
}

model Booking {
  id                   String               @id @default(cuid())
  ownerId              String
  owner                User                 @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  trailId              String
  trail                Trail                @relation(fields: [trailId], references: [id], onDelete: Restrict)
  scheduledDate        String
  scheduledTime        String
  packagePrice         Int
  downpaymentAmount    Int
  status               BookingStatus        @default(PENDING_CONFIRMATION)
  downpaymentStatus    DownpaymentStatus    @default(PENDING_VERIFICATION)
  paymentOption        PaymentOption        @default(DOWNPAYMENT)
  // Cash balance (DOWNPAYMENT bookings) received by a coordinator at check-in.
  balanceCollectedAt   DateTime?
  balanceCollectedById String?
  balanceCollectedBy   User?                @relation("BookingBalanceCollector", fields: [balanceCollectedById], references: [id], onDelete: SetNull)
  guideId              String?
  guide                Guide?               @relation(fields: [guideId], references: [id], onDelete: Restrict)
  checkedInAt          DateTime?
  guideAssignedAt      DateTime?
  trekStartedAt        DateTime?
  completedAt          DateTime?
  // Trek waiver and trail rules the owner accepted for the whole group.
  waiverAcceptedAt     DateTime?
  waiverVersion        String?
  participants         BookingParticipant[]
  incidents            Incident[]
  locations            GuideLocation[]
  paymentReceipts      PaymentReceipt[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([ownerId, createdAt])
  @@index([trailId, scheduledDate])
  @@index([status, checkedInAt])
  @@index([guideId])
  @@map("bookings")
}

model BookingParticipant {
  id                String                 @id @default(cuid())
  bookingId         String
  booking           Booking                @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  kind              BookingParticipantType
  name              String
  age               Int
  address           String
  // Where the certificate goes; without one it is sent to the booking owner.
  email             String?
  attendance        ParticipantAttendance?
  // Set once the certificate email is sent, so it is never sent twice.
  certificateSentAt DateTime?

  @@index([bookingId])
  @@map("booking_participants")
}

// A GCash receipt screenshot the hiker uploaded. Every upload is kept, so a
// rejected receipt stays in the history after the hiker uploads a new one.
// The image is stored on disk under UPLOAD_DIR/receipts/<storedFileName>.
model PaymentReceipt {
  id              String        @id @default(cuid())
  bookingId       String
  booking         Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount          Int
  referenceNumber String?
  storedFileName  String        @unique
  mimeType        String
  sizeBytes       Int
  status          ReceiptStatus @default(SUBMITTED)
  rejectionReason String?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?         @relation("PaymentReceiptReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@index([bookingId, createdAt])
  @@map("payment_receipts")
}

enum IncidentStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

// A guide's in-app SOS for a trek (Phase 8). The booking's status is not
// changed. A booking has at most one unresolved incident: a partial unique
// index in the migration enforces it, so a repeated SOS returns the same one.
model Incident {
  id               String         @id @default(cuid())
  bookingId        String
  booking          Booking        @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  guideId          String
  guide            Guide          @relation(fields: [guideId], references: [id], onDelete: Restrict)
  status           IncidentStatus @default(OPEN)
  latitude         Float?
  longitude        Float?
  accuracyM        Float?
  locationAt       DateTime?
  note             String?
  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?          @relation("IncidentAcknowledger", fields: [acknowledgedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedById     String?
  resolvedBy       User?          @relation("IncidentResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote   String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([status, createdAt])
  @@index([bookingId])
  @@map("incidents")
}

// A guide's GPS fix during a started trek, so a coordinator can follow the
// group live and see the path walked so far. Fixes may arrive late in a batch
// after the phone loses signal; recordedAt is when the phone took the fix.
model GuideLocation {
  id         String   @id @default(cuid())
  bookingId  String
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guideId    String
  guide      Guide    @relation(fields: [guideId], references: [id], onDelete: Restrict)
  latitude   Float
  longitude  Float
  accuracyM  Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  @@index([bookingId, recordedAt])
  @@map("guide_locations")
}
