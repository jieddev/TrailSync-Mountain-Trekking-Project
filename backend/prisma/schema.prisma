generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  HIKER
  GUIDE
  COORDINATOR
}

model User {
  id          String   @id @default(cuid())
  firebaseUid String   @unique
  fullName    String
  email       String   @unique
  role        UserRole @default(HIKER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("users")
}
